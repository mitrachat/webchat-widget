{
  "name": "@mitrachat/webchat-widget",
  "version": "1.0.0",
  "description": "Embeddable WebChat widget for MitraChat",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./embed": "./dist/embed.iife.js",
    "./style.css": "./dist/webchat-widget.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && BUILD_TARGET=embed vite build && tsc --emitDeclarationOnly",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@orpc/client": "^1.13.1",
    "marked": "^17.0.5"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "jsdom": "^29.0.2",
    "lucide-svelte": "^0.475.0",
    "postcss": "^8.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.2",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "webchat",
    "widget",
    "chat",
    "mitrachat",
    "svelte"
  ],
  "license": "MIT",
  "homepage": "https://github.com/mitrachat/webchat-widget#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/mitrachat/webchat-widget.git"
  },
  "bugs": {
    "url": "https://github.com/mitrachat/webchat-widget/issues"
  }
}
